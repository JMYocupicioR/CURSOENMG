# NeuroSAFE — variables de entorno (nunca commitear .env)
# Copia este archivo como .env y completa los valores reales.

# Supabase (anon/public; NO uses service_role en el cliente)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Solo servidor (Vite proxy / Netlify). Nunca prefijar con VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# Verificación de cédula SEP — solo servidor local / Edge Function secrets
# Rotar si alguna vez se filtró en git. No prefijar con VITE_.
SEP_CLIENT_ID=
SEP_API_KEY=

# Orígenes permitidos para Edge Functions (CSV)
ALLOWED_ORIGINS=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173

# Web Push — clave pública en el cliente; privada solo en secrets de Edge Function
VITE_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": [
    "src/vite-env.d.ts",
    "ejercicios/src/components/ExerciseMode.tsx",
    "ejercicios/src/components/tools/**/*.ts",
    "ejercicios/src/components/tools/**/*.tsx",
    "ejercicios/src/data/CaseTemplates*.ts",
    "ejercicios/src/services/ClinicalCaseEngine.ts",
    "ejercicios/src/store/exerciseStore.ts",
    "ejercicios/src/types/ClinicalCase.ts"
  ]
}

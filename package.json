{
  "name": "electodx-diplomado",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "allowScripts": {
    "esbuild@0.21.5": true,
    "sharp@0.34.5": true,
    "core-js@2.6.12": false,
    "es5-ext@0.10.64": false
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:ejercicios": "tsc --noEmit -p tsconfig.ejercicios.json",
    "validate:content": "node scripts/generate-clinical-content.mjs && npx --yes tsx --import ./scripts/register-assets.mjs scripts/generate-temario.ts",
    "validate:quizzes": "node scripts/validate-quizzes.mjs",
    "import:pending-quizzes": "node scripts/import-pending-quizzes.mjs",
    "validate:secrets": "node scripts/check-secrets.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.0.16",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/supabase-js": "^2.108.2",
    "@types/node": "^22.14.1",
    "docx": "^9.7.2",
    "framer-motion": "^12.35.1",
    "lucide-react": "^0.344.0",
    "pagedjs": "^0.4.3",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-error-boundary": "^5.0.0",
    "react-router-dom": "^6.22.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^8.56.0",
    "@testing-library/react": "^14.2.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "globals": "^13.24.0",
    "postcss": "^8.4.35",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.3",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^1.2.2"
  }
}
